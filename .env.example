# FastAPI Environment Variables
# This .env file will be used in the root directory later for FastAPI backend.
# Copy this file to .env and fill in your actual values.

# Supabase Admin/Service Role Key (if needed for FastAPI)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# FastAPI Secret Key
FASTAPI_SECRET_KEY=your_fastapi_secret_key_here

# Database URL or other FastAPI configs
DATABASE_URL=postgresql://username:password@localhost/dbname

# Example: Port for FastAPI
PORT=8000

# Note: Next.js vars are in ui/.env.local